              </div>\
              <div class="text-[11px] text-stone-400 flex items-center space-x-2">\
                <span>$\{item.date\}</span>\
                <span>\'95</span>\
                <span>\uc0\u22666 \u27454 \u65306 $\{item.payer\}</span>\
                <span>\'95</span>\
                <span class="$\{item.receipt === '\uc0\u24453 \u35036 \u21934 \u25818 ' ? 'text-amber-600 font-medium' : ''\}">$\{item.receipt\}</span>\
              </div>\
            </div>\
            <div class="flex items-center space-x-3">\
              <span class="font-bold text-sm text-stone-800">$$\{Number(item.amount).toLocaleString()\}</span>\
              <button onclick="deleteExpense($\{index\})" class="text-stone-300 hover:text-rose-500 text-sm font-bold p-1">\uc0\u10005 </button>\
            </div>\
          `;\
          listEl.appendChild(card);\
        \});\
      \}\
\
      document.getElementById('totalDisplay').textContent = `\uc0\u32317 \u25903 \u20986 \u65306 $$\{total.toLocaleString()\}`;\
      document.getElementById('entryCount').textContent = `\uc0\u20849  $\{expenses.length\} \u31558 `;\
\
      updateChart(categoryTotals);\
      localStorage.setItem('prod_expenses', JSON.stringify(expenses));\
