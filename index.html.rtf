  <script>\
    let expenses = JSON.parse(localStorage.getItem('prod_expenses') || '[]');\
    let chartInstance = null;\
\
    // \uc0\u21021 \u22987 \u21270 \u26085 \u26399 \u28858 \u20170 \u22825 \
    document.getElementById('dateInput').value = new Date().toISOString().split('T')[0];\
\
    function render() \{\
      const listEl = document.getElementById('expenseList');\
      listEl.innerHTML = '';\
\
      let total = 0;\
